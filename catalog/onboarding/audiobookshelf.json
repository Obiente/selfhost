{
  "schema": 1,
  "name": "Audiobookshelf administrator setup",
  "state_path": "/status",
  "state_pointer": "/isInit",
  "initial_state": "false",
  "board_url": "{base}",
  "default_icon": "",
  "app_name_max": 255,
  "app_description_max": 512,
  "warnings": [
    "Creates the first administrator only. Existing installations are never reset. Library paths and media access remain under your control."
  ],
  "fields": [
    {
      "id": "username",
      "label": "Administrator username",
      "kind": "string",
      "required": true,
      "modes": ["bootstrap"],
      "minimum_length": 1,
      "maximum_length": 64,
      "default": "admin"
    },
    {
      "id": "password",
      "label": "Administrator password",
      "kind": "secret",
      "required": true,
      "modes": ["bootstrap"],
      "minimum_length": 12,
      "maximum_length": 128
    }
  ],
  "steps": [
    {
      "id": "administrator",
      "label": "Create the first administrator",
      "method": "POST",
      "path": "/init",
      "body": {
        "newRoot": {
          "username": "{username}",
          "password": "{password}"
        }
      },
      "response_text": true,
      "modes": ["bootstrap"]
    },
    {
      "id": "verify",
      "label": "Verify server initialization",
      "method": "GET",
      "path": "/status",
      "expect": {
        "/isInit": true
      },
      "modes": ["bootstrap"]
    }
  ]
}
