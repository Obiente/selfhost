{
  "engine": "postgres",
  "name": "PostgreSQL",
  "image": "postgres:17-alpine",
  "port": 5432,
  "data_path": "/var/lib/postgresql/data",
  "healthcheck": {
    "test": ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""],
    "interval": "5s",
    "timeout": "5s",
    "retries": 20
  }
}
